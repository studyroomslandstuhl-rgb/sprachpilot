rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verifiedUser() {
      return signedIn() &&
        request.auth.token.get('email_verified', false) == true &&
        request.auth.token.firebase.sign_in_provider == 'password';
    }

    function authEmail() {
      return signedIn() ? request.auth.token.get('email', '').lower().trim() : '';
    }

    function legacyVerifiedEmail(data) {
      return verifiedUser() &&
        data.get('authUid', '') == '' &&
        data.get('email', '').lower().trim() == authEmail();
    }

    function reasonableSize() {
      return request.resource.data.size() < 200;
    }

    function ownerEmail() {
      return verifiedUser() && authEmail() in [
        'studyroomslandstuhl@gmail.com',
        'alicekrekoten@gmail.com',
        'alisa.krekoten@gmail.com'
      ];
    }

    function teacherRecordExists() {
      return signedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function teacherSecurityReady() {
      return exists(/databases/$(database)/documents/settings/teacherSecurity) &&
        get(/databases/$(database)/documents/settings/teacherSecurity).data.get('teacherSecurityVersion', 0) >= 2 &&
        get(/databases/$(database)/documents/settings/teacherSecurity).data.get('generation', '') != '';
    }

    function approvedTeacher() {
      return verifiedUser() && teacherRecordExists() && teacherSecurityReady() &&
        get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('active', true) == true &&
        get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('securityApprovedV2', false) == true &&
        get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('securityApprovalGeneration', '') ==
          get(/databases/$(database)/documents/settings/teacherSecurity).data.get('generation', '');
    }

    function isTeacher() {
      return ownerEmail() || approvedTeacher();
    }

    function ownsStudentData(data) {
      return verifiedUser() && data.get('authUid', '') == request.auth.uid;
    }

    function ownsStudentId(studentId) {
      return verifiedUser() &&
        exists(/databases/$(database)/documents/students/$(studentId)) &&
        get(/databases/$(database)/documents/students/$(studentId)).data.get('authUid', '') == request.auth.uid;
    }

    function studentAliasAllowed(canonicalId, progressId) {
      return ownsStudentId(canonicalId) && (
        progressId == canonicalId ||
        progressId in get(/databases/$(database)/documents/students/$(canonicalId)).data.get('aliasIds', [])
      );
    }

    function progressTargetAllowed(data, progressId) {
      let canonical = data.get('canonicalStudentId', '');
      return ownsStudentId(progressId) ||
        (canonical != '' && studentAliasAllowed(canonical, progressId));
    }

    function studentIdentityStable(studentId) {
      return request.resource.data.get('authUid', '') == resource.data.get('authUid', '') &&
        request.resource.data.get('authEmail', '').lower().trim() == resource.data.get('authEmail', '').lower().trim() &&
        request.resource.data.get('email', '').lower().trim() == resource.data.get('email', '').lower().trim() &&
        resource.data.get('canonicalStudentId', studentId) == studentId &&
        request.resource.data.get('canonicalStudentId', studentId) == studentId &&
        resource.data.get('docId', studentId) == studentId &&
        request.resource.data.get('docId', studentId) == studentId &&
        resource.data.get('studentId', studentId) == studentId &&
        request.resource.data.get('studentId', studentId) == studentId &&
        resource.data.get('userId', studentId) == studentId &&
        request.resource.data.get('userId', studentId) == studentId &&
        request.resource.data.get('aliasIds', [studentId]).hasOnly(
          resource.data.get('aliasIds', []).concat([studentId])
        ) &&
        request.resource.data.get('aliasIds', [studentId]).hasAll(
          resource.data.get('aliasIds', [])
        );
    }

    function studentCreateIdentitySafe(studentId) {
      return request.resource.data.get('canonicalStudentId', studentId) == studentId &&
        request.resource.data.get('docId', studentId) == studentId &&
        request.resource.data.get('studentId', studentId) == studentId &&
        request.resource.data.get('userId', studentId) == studentId &&
        request.resource.data.get('aliasIds', [studentId]).hasOnly([studentId]);
    }

    function studentCourseKey(studentId) {
      return get(/databases/$(database)/documents/students/$(studentId)).data.get(
        'courseDocId',
        get(/databases/$(database)/documents/students/$(studentId)).data.get(
          'courseCode',
          get(/databases/$(database)/documents/students/$(studentId)).data.get(
            'kurs',
            get(/databases/$(database)/documents/students/$(studentId)).data.get('kursnummer', '')
          )
        )
      );
    }

    function rankingWriteSafe(studentId) {
      return verifiedUser() && ownsStudentId(studentId) &&
        request.resource.data.keys().hasOnly([
          'studentId','authUid','displayName','courseKey','points','version','updatedAt'
        ]) &&
        request.resource.data.get('studentId', '') == studentId &&
        request.resource.data.get('authUid', '') == request.auth.uid &&
        request.resource.data.get('courseKey', '') == studentCourseKey(studentId) &&
        request.resource.data.get('points', -1) >= 0;
    }

    function legacyStudentClaimAllowed() {
      return legacyVerifiedEmail(resource.data) &&
        request.resource.data.get('authUid', '') == request.auth.uid &&
        request.resource.data.get('authEmail', '').lower().trim() == authEmail() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'authUid', 'authEmail', 'authVersion', 'authLinkedAt'
        ]);
    }

    function progressOwnedByUser(data, progressId) {
      return verifiedUser() &&
        data.get('securityArchived', false) != true &&
        (
          progressTargetAllowed(data, progressId) ||
          legacyVerifiedEmail(data)
        );
    }

    function progressCreateBindingSafe(data) {
      return data.get('authUid', '') == '' || (
        data.get('authUid', '') == request.auth.uid &&
        (
          data.get('authEmail', '') == '' ||
          data.get('authEmail', '').lower().trim() == authEmail()
        )
      );
    }

    function progressUpdateBindingSafe() {
      return (
        resource.data.get('authUid', '') == '' &&
        (
          request.resource.data.get('authUid', '') == '' ||
          request.resource.data.get('authUid', '') == request.auth.uid
        )
      ) || (
        resource.data.get('authUid', '') != '' &&
        resource.data.get('authUid', '') == request.auth.uid &&
        request.resource.data.get('authUid', '') == resource.data.get('authUid', '') &&
        request.resource.data.get('authEmail', '').lower().trim() == resource.data.get('authEmail', '').lower().trim()
      );
    }

    match /courses/{courseId} {
      allow read: if signedIn();
      allow create, update: if isTeacher() && reasonableSize();
      allow delete: if isTeacher();
    }

    match /studentLookups/{lookupId} {
      allow get: if isTeacher() || (
        verifiedUser() && resource.data.get('email', '').lower().trim() == authEmail()
      );
      allow list: if isTeacher();
      allow create, update: if isTeacher() && reasonableSize();
      allow delete: if isTeacher();
    }

    match /students/{studentId} {
      allow get: if isTeacher() || ownsStudentData(resource.data) || legacyVerifiedEmail(resource.data);
      allow list: if isTeacher() || ownsStudentData(resource.data);

      allow create: if isTeacher() || (
        verifiedUser() && reasonableSize() &&
        studentCreateIdentitySafe(studentId) &&
        request.resource.data.get('authUid', '') == request.auth.uid &&
        request.resource.data.get('authEmail', '').lower().trim() == authEmail() &&
        request.resource.data.get('email', '').lower().trim() == authEmail()
      );

      allow update: if isTeacher() || (
        reasonableSize() && (
          legacyStudentClaimAllowed() ||
          (
            ownsStudentData(resource.data) &&
            studentIdentityStable(studentId)
          )
        )
      );

      allow delete: if isTeacher();
    }

    match /progress/{progressId} {
      allow get: if isTeacher() || progressOwnedByUser(resource.data, progressId);
      allow list: if isTeacher();

      allow create: if isTeacher() || (
        verifiedUser() && reasonableSize() &&
        request.resource.data.get('securityArchived', false) != true &&
        progressCreateBindingSafe(request.resource.data) &&
        progressTargetAllowed(request.resource.data, progressId)
      );

      allow update: if isTeacher() || (
        reasonableSize() &&
        resource.data.get('securityArchived', false) != true &&
        request.resource.data.get('securityArchived', false) != true &&
        progressUpdateBindingSafe() &&
        progressTargetAllowed(resource.data, progressId) &&
        progressTargetAllowed(request.resource.data, progressId)
      );

      allow delete: if isTeacher();
    }

    match /studentRankings/{studentId} {
      allow read: if verifiedUser();
      allow create: if isTeacher() || (
        reasonableSize() && rankingWriteSafe(studentId)
      );
      allow update: if isTeacher() || (
        reasonableSize() && rankingWriteSafe(studentId) &&
        (resource.data.get('authUid', '') == '' || resource.data.get('authUid', '') == request.auth.uid)
      );
      allow delete: if isTeacher();
    }

    match /teachers/{teacherId} {
      allow get: if ownerEmail() || (signedIn() && teacherId == request.auth.uid);
      allow list: if ownerEmail();
      allow create, update: if ownerEmail() && reasonableSize();
      allow delete: if ownerEmail();
    }

    match /teachers_pending/{teacherId} {
      allow get: if ownerEmail() || (signedIn() && teacherId == request.auth.uid);
      allow list: if ownerEmail();
      allow create: if signedIn() && teacherId == request.auth.uid && reasonableSize();
      allow update: if ownerEmail() && reasonableSize();
      allow delete: if ownerEmail();
    }

    match /teacherInvites/{inviteId} {
      allow read, create, update, delete: if isTeacher();
    }

    match /courseInvites/{inviteId} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacher();
    }

    match /releases/{releaseId} {
      allow read: if signedIn();
      allow create, update: if isTeacher() && reasonableSize();
      allow delete: if isTeacher();
    }

    match /assignments/{assignmentId} {
      allow read: if signedIn();
      allow create, update: if isTeacher() && reasonableSize();
      allow delete: if isTeacher();
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow create, update: if reasonableSize() && (
        (settingId in ['teacherSecurity','authMailTemplates'] && ownerEmail()) ||
        (!(settingId in ['teacherSecurity','authMailTemplates']) && isTeacher())
      );
      allow delete: if (
        (settingId in ['teacherSecurity','authMailTemplates'] && ownerEmail()) ||
        (!(settingId in ['teacherSecurity','authMailTemplates']) && isTeacher())
      );
    }

    match /diagnostics/{docId} {
      allow create: if signedIn() && reasonableSize();
      allow read, update, delete: if isTeacher();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
