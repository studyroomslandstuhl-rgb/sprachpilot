rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verifiedUser() {
      return signedIn() && request.auth.token.get('email_verified', false) == true;
    }

    function authEmail() {
      return signedIn() ? request.auth.token.get('email', '').lower().trim() : '';
    }

    // E-Mail ist ausschließlich ein einmaliger Migrationsschlüssel für einen
    // DIREKTEN Dokumentabruf alter, noch nicht UID-gebundener Daten.
    function legacyVerifiedEmail(data) {
      return verifiedUser() &&
        data.get('authUid', '') == '' &&
        data.get('email', '').lower().trim() == authEmail();
    }

    function reasonableSize() {
      return request.resource.data.size() < 200;
    }

    function ownerEmail() {
      return signedIn() && authEmail() in [
        'studyroomslandstuhl@gmail.com',
        'alicekrekoten@gmail.com',
        'alisa.krekoten@gmail.com'
      ];
    }

    function teacherRecordExists() {
      return signedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function approvedTeacher() {
      return teacherRecordExists() &&
        get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('active', true) == true &&
        (
          get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('owner', false) == true ||
          get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('admin', false) == true ||
          get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('approved', false) == true ||
          get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('isTeacher', false) == true
        );
    }

    function isTeacher() {
      return ownerEmail() || approvedTeacher();
    }

    function ownsStudentData(data) {
      return verifiedUser() && data.get('authUid', '') == request.auth.uid;
    }

    function ownsStudentId(studentId) {
      return verifiedUser() &&
        exists(/databases/$(database)/documents/students/$(studentId)) &&
        get(/databases/$(database)/documents/students/$(studentId)).data.get('authUid', '') == request.auth.uid;
    }

    function legacyStudentClaimAllowed() {
      return legacyVerifiedEmail(resource.data) &&
        request.resource.data.get('authUid', '') == request.auth.uid &&
        request.resource.data.get('authEmail', '').lower().trim() == authEmail() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'authUid', 'authEmail', 'authVersion', 'authLinkedAt'
        ]);
    }

    function progressOwnedByUser(data, studentId) {
      return verifiedUser() && (
        data.get('authUid', '') == request.auth.uid ||
        ownsStudentId(studentId) ||
        (
          data.get('canonicalStudentId', '') != '' &&
          ownsStudentId(data.get('canonicalStudentId', ''))
        ) ||
        legacyVerifiedEmail(data)
      );
    }

    function progressCreateBindingSafe(data) {
      return data.get('authUid', '') == '' || (
        data.get('authUid', '') == request.auth.uid &&
        (
          data.get('authEmail', '') == '' ||
          data.get('authEmail', '').lower().trim() == authEmail()
        )
      );
    }

    function progressUpdateBindingSafe() {
      return (
        resource.data.get('authUid', '') == '' &&
        (
          request.resource.data.get('authUid', '') == '' ||
          request.resource.data.get('authUid', '') == request.auth.uid
        )
      ) || (
        resource.data.get('authUid', '') != '' &&
        resource.data.get('authUid', '') == request.auth.uid &&
        request.resource.data.get('authUid', '') == resource.data.get('authUid', '') &&
        request.resource.data.get('authEmail', '').lower().trim() == resource.data.get('authEmail', '').lower().trim()
      );
    }

    match /courses/{courseId} {
      allow read: if signedIn();
      allow create, update: if isTeacher() && reasonableSize();
      allow delete: if isTeacher();
    }

    match /studentLookups/{lookupId} {
      // Lookup-Dokumente sind niemals für Schüler auflistbar. Ein verifizierter
      // Schüler darf nur einen bereits bekannten direkten Schlüssel lesen, der
      // exakt seine eigene Firebase-E-Mail trägt.
      allow get: if isTeacher() || (
        verifiedUser() && resource.data.get('email', '').lower().trim() == authEmail()
      );
      allow list: if isTeacher();
      allow create, update: if isTeacher() && reasonableSize();
      allow delete: if isTeacher();
    }

    match /students/{studentId} {
      // Direkter Abruf: UID-Eigentümer oder einmalige Alt-Migration per verifizierter E-Mail.
      allow get: if isTeacher() || ownsStudentData(resource.data) || legacyVerifiedEmail(resource.data);
      // Collection-Queries für Schüler sind ausschließlich über die eigene UID zulässig.
      // E-Mail-basierte Studentensuchen können damit nicht mehr autorisiert werden.
      allow list: if isTeacher() || (
        verifiedUser() && resource.data.get('authUid', '') == request.auth.uid
      );

      allow create: if isTeacher() || (
        verifiedUser() &&
        reasonableSize() &&
        request.resource.data.get('authUid', '') == request.auth.uid &&
        request.resource.data.get('authEmail', '').lower().trim() == authEmail() &&
        request.resource.data.get('email', '').lower().trim() == authEmail()
      );

      allow update: if isTeacher() || (
        reasonableSize() && (
          legacyStudentClaimAllowed() ||
          (
            ownsStudentData(resource.data) &&
            request.resource.data.get('authUid', '') == resource.data.get('authUid', '') &&
            request.resource.data.get('authEmail', '').lower().trim() == resource.data.get('authEmail', '').lower().trim() &&
            request.resource.data.get('email', '').lower().trim() == resource.data.get('email', '').lower().trim()
          )
        )
      );

      allow delete: if isTeacher();
    }

    match /progress/{studentId} {
      allow get: if isTeacher() || progressOwnedByUser(resource.data, studentId);
      // Der neue Schüler-Sync benötigt keine Collection-Queries mehr. Falls eine
      // Altseite doch listet, darf sie ausschließlich UID-gebundene eigene Zeilen sehen.
      allow list: if isTeacher() || (
        verifiedUser() && resource.data.get('authUid', '') == request.auth.uid
      );

      allow create: if isTeacher() || (
        verifiedUser() &&
        reasonableSize() &&
        progressCreateBindingSafe(request.resource.data) &&
        progressOwnedByUser(request.resource.data, studentId)
      );

      allow update: if isTeacher() || (
        reasonableSize() &&
        progressUpdateBindingSafe() &&
        progressOwnedByUser(resource.data, studentId) &&
        progressOwnedByUser(request.resource.data, studentId)
      );

      allow delete: if isTeacher();
    }

    match /teachers/{teacherId} {
      allow read: if isTeacher() || (signedIn() && teacherId == request.auth.uid);
      allow create, update: if isTeacher() && reasonableSize();
      allow delete: if isTeacher();
    }

    match /teachers_pending/{teacherId} {
      allow read: if isTeacher() || (signedIn() && teacherId == request.auth.uid);
      allow create: if signedIn() && teacherId == request.auth.uid && reasonableSize();
      allow update: if isTeacher() && reasonableSize();
      allow delete: if isTeacher();
    }

    match /teacherInvites/{inviteId} {
      allow read, create, update, delete: if isTeacher();
    }

    match /courseInvites/{inviteId} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacher();
    }

    match /releases/{releaseId} {
      allow read: if signedIn();
      allow create, update: if isTeacher() && reasonableSize();
      allow delete: if isTeacher();
    }

    match /assignments/{assignmentId} {
      allow read: if signedIn();
      allow create, update: if isTeacher() && reasonableSize();
      allow delete: if isTeacher();
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow create, update: if isTeacher() && reasonableSize();
      allow delete: if isTeacher();
    }

    match /diagnostics/{docId} {
      allow create: if signedIn() && reasonableSize();
      allow read, update, delete: if isTeacher();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
